{
  "sourceLanguage": "en",
  "strings": {
    "backup.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export full backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортировать полную резервную копию"
          }
        }
      }
    },
    "backup.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TripDocket has no account or cloud sync. Export a backup to a place you trust before deleting the app or changing devices. A successful restore replaces the entire current library. Viewing, export and recovery do not require Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В TripDocket нет аккаунта и облачной синхронизации. Перед удалением приложения или сменой устройства экспортируйте резервную копию в надёжное место. Успешное восстановление заменяет всю текущую библиотеку. Просмотр, экспорт и восстановление не требуют Pro."
          }
        }
      }
    },
    "backup.replace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace library from backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить библиотеку из резервной копии"
          }
        }
      }
    },
    "backup.replaceBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This will replace %lld current document, all trips and people with the selected backup. Export your current library first if you need to keep it. The backup is validated before replacement; a failed restore keeps your current library."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This will replace all %lld current documents, trips and people with the selected backup. Export your current library first if you need to keep it. The backup is validated before replacement; a failed restore keeps your current library."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выбранная резервная копия заменит %lld текущих документа, все поездки и людей. Если нужно сохранить текущую библиотеку, сначала экспортируйте её. Резервная копия проверяется перед заменой; при ошибке восстановления текущая библиотека сохраняется."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выбранная резервная копия заменит все %lld текущих документов, поездки и людей. Если нужно сохранить текущую библиотеку, сначала экспортируйте её. Резервная копия проверяется перед заменой; при ошибке восстановления текущая библиотека сохраняется."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выбранная резервная копия заменит %lld текущий документ, все поездки и людей. Если нужно сохранить текущую библиотеку, сначала экспортируйте её. Резервная копия проверяется перед заменой; при ошибке восстановления текущая библиотека сохраняется."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Выбранная резервная копия заменит %lld текущих документа, все поездки и людей. Если нужно сохранить текущую библиотеку, сначала экспортируйте её. Резервная копия проверяется перед заменой; при ошибке восстановления текущая библиотека сохраняется."
                }
              }
            }
          }
        }
      }
    },
    "backup.replaceTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace your entire library?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить всю библиотеку?"
          }
        }
      }
    },
    "backup.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить из резервной копии"
          }
        }
      }
    },
    "backup.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup & recovery"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное копирование и восстановление"
          }
        }
      }
    },
    "backup.warning.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup includes every original document, person and trip in readable, unencrypted form. Anyone with a copy can access them. Keep it in a trusted location. Previously shared copies cannot be revoked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия содержит все оригиналы документов, сведения о путешественниках и поездках в открытом, незашифрованном виде. Любой, у кого есть копия, может получить к ним доступ. Храните её в надёжном месте. Ранее переданные копии нельзя отозвать."
          }
        }
      }
    },
    "backup.warning.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export an unencrypted backup?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортировать копию без шифрования?"
          }
        }
      }
    },
    "batch.atomicHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole batch is added together. If saving fails, none of these documents is added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь набор добавляется одновременно. Если сохранить его не удастся, ни один документ из набора не будет добавлен."
          }
        }
      }
    },
    "batch.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available in this library: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно в библиотеке: %@."
          }
        }
      }
    },
    "batch.beforeSave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you save"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед сохранением"
          }
        }
      }
    },
    "batch.cancelHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel discards the prepared copies. The files you selected and your current library are left unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отмене подготовленные копии удаляются. Выбранные файлы и текущая библиотека не изменяются."
          }
        }
      }
    },
    "batch.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать файлы"
          }
        }
      }
    },
    "batch.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this document"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердить документ"
          }
        }
      }
    },
    "batch.confirmHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that these details belong to this file. “Everyone / unassigned” and no expiry date are valid choices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что эти сведения относятся к данному файлу. Можно выбрать «Для всех / не назначен» и не указывать дату истечения срока."
          }
        }
      }
    },
    "batch.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These details are confirmed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения подтверждены"
          }
        }
      }
    },
    "batch.dateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the date from the original. The app does not infer a date or check travel requirements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите дату по оригиналу. Приложение не определяет дату автоматически и не проверяет требования к поездке."
          }
        }
      }
    },
    "batch.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files remain in this batch. Cancel to return to the trip and start again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом наборе не осталось файлов. Нажмите «Отмена», чтобы вернуться к поездке и начать снова."
          }
        }
      }
    },
    "batch.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to 10 PDF, JPEG or PNG files for this trip, then review every document before saving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите до 10 файлов PDF, JPEG или PNG для этой поездки, затем проверьте каждый документ перед сохранением."
          }
        }
      }
    },
    "batch.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each file can be up to 16 MiB. The entire library can hold up to 64 MiB of originals."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер каждого файла — до 16 МиБ. Вся библиотека вмещает до 64 МиБ оригиналов."
          }
        }
      }
    },
    "batch.memoryHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved files and details stay in memory while the app is running, including while it is locked. Quitting the app discards this draft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несохранённые файлы и сведения остаются в памяти, пока приложение работает, в том числе при его блокировке. Закрытие приложения удаляет этот черновик."
          }
        }
      }
    },
    "batch.navigationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import files"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт файлов"
          }
        }
      }
    },
    "batch.needsReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна проверка"
          }
        }
      }
    },
    "batch.noExpiry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expiry date will be saved for this document."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата истечения срока для этого документа не будет сохранена."
          }
        }
      }
    },
    "batch.preparingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying the full originals into this unsaved draft. Your library has not changed. Cloud files may need to download first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полные оригиналы копируются в несохранённый черновик. Ваша библиотека не изменена. Сначала может потребоваться загрузить файлы из облака."
          }
        }
      }
    },
    "batch.previewError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared original could not be opened. Try again or remove this file from the batch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть подготовленный оригинал. Попробуйте ещё раз или удалите файл из набора."
          }
        }
      }
    },
    "batch.proAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import multiple files · Pro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт нескольких файлов · Pro"
          }
        }
      }
    },
    "batch.proHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is required to prepare and save multiple files. A prepared draft can be reviewed, but cannot be saved while Pro is inactive. Existing documents stay available in your library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подготовки и сохранения нескольких файлов нужен Pro. Готовый черновик можно просмотреть, но нельзя сохранить, пока Pro не активен. Существующие документы остаются доступны в библиотеке."
          }
        }
      }
    },
    "batch.progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing files: %1$lld of %2$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка файлов: %1$lld из %2$lld"
          }
        }
      }
    },
    "batch.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from batch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить из набора"
          }
        }
      }
    },
    "batch.removeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the unsaved copy from this batch. The original file is kept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется только несохранённая копия из этого набора. Файл оригинала сохраняется."
          }
        }
      }
    },
    "batch.reviewAX": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review %1$@, file %2$@, %3$@, %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить %1$@, файл %2$@, %3$@, %4$@"
          }
        }
      }
    },
    "batch.reviewHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open each file to confirm its title, type, person and expiry-date choice. Editing a confirmed detail makes that file need review again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте каждый файл и подтвердите название, тип, человека и выбор даты истечения срока. После изменения подтверждённых сведений файл нужно проверить заново."
          }
        }
      }
    },
    "batch.reviewProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld reviewed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверено %1$lld из %2$lld"
          }
        }
      }
    },
    "batch.reviewRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review required"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется проверка"
          }
        }
      }
    },
    "batch.reviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review document"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка документа"
          }
        }
      }
    },
    "batch.reviewed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверен"
          }
        }
      }
    },
    "batch.saveCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Save %lld document"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Save %lld documents"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сохранить %lld документа"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сохранить %lld документов"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сохранить %lld документ"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Сохранить %lld документа"
                }
              }
            }
          }
        }
      }
    },
    "batch.saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the complete batch…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение всего набора…"
          }
        }
      }
    },
    "batch.savingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait until all documents have been saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь сохранения всех документов."
          }
        }
      }
    },
    "batch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import multiple files"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт нескольких файлов"
          }
        }
      }
    },
    "batch.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose no more than 10 files. No files were prepared or added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите не более 10 файлов. Файлы не были подготовлены или добавлены."
          }
        }
      }
    },
    "batch.viewOriginal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View original"
          }
        },
        "ru": {
