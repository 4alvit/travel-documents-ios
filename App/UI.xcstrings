    "reminder.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that %@ matches the original document. A generic notification is scheduled 30 days before at 9 AM in the time zone used when scheduled, or the next 9 AM in that zone before expiry if closer. Traveling to another time zone does not automatically move this reminder. Delivery depends on your device settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что дата %@ совпадает с оригиналом документа. Уведомление без личных сведений планируется за 30 дней до этой даты на 9:00 в часовом поясе, выбранном при создании. Если до истечения срока меньше 30 дней, выбирается ближайшее 9:00 в том же поясе до истечения срока. При смене часового пояса время напоминания автоматически не меняется. Доставка зависит от настроек устройства."
          }
        }
      }
    },
    "reminder.noDate": {
      "extractionState": "manual",
      "localizations": {
