    "settings.protectionHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a device passcode enabled. Documents use iOS file protection; exported packets are unencrypted copies outside the app’s protection. Share only with recipients and destinations you trust."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отключайте код-пароль устройства. Документы используют защиту файлов iOS; экспортированные наборы — незашифрованные копии вне защиты приложения. Передавайте их только доверенным получателям и сохраняйте в надёжных местах."
          }
        }
      }
    },
