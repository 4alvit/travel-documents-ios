    "ocr.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions can be wrong. Edit them before use. Only the title you choose is saved; the extracted text is discarded. Recognition checks up to the first 3 PDF pages and never fills in dates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты могут содержать ошибки. Исправьте их перед использованием. Сохраняется только выбранное вами название; распознанный текст удаляется. Проверяются до 3 первых страниц PDF. Даты не заполняются автоматически."
          }
        }
      }
    },
